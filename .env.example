# ============================================================================
# CONFIGURACIÓN DEL PROYECTO - FASE 1
# ============================================================================
# 
# Este archivo documenta las variables de configuración del sistema.
# En FASE 2, estos valores se pueden mover a Key Vault o Secrets Manager
#

# ============================================================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ============================================================================

# Ambiente: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Development

# Puerto de ejecución
PORT=5000
HTTPS_PORT=5001

# URL de la API (usada por el frontend)
API_URL=http://localhost:5000/api

# Nombre de la aplicación
APP_NAME=Portal Multitenant de Pago de Servicios

# ============================================================================
# BASE DE DATOS (Para FASE 2)
# ============================================================================

# Tipo de base de datos: InMemory (FASE 1) o SqlServer (FASE 2)
DATABASE_TYPE=InMemory

# Cadena de conexión SQL Server (descomentar para FASE 2)
# CONNECTION_STRING=Server=.\SQLEXPRESS;Database=PortalPagos;Trusted_Connection=true;TrustServerCertificate=true;

# ============================================================================
# SEGURIDAD (Para FASE 2+)
# ============================================================================

# Clave secreta para JWT
# JWT_SECRET=tu-clave-secreta-muy-larga-aqui

# Issuer JWT
# JWT_ISSUER=PortalPagos

# Audience JWT
# JWT_AUDIENCE=PortalPagosApp

# Tiempo de expiración del token (minutos)
# JWT_EXPIRATION_MINUTES=60

# ============================================================================
# CORREO (Para notificaciones - FASE 3)
# ============================================================================

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=tu-email@gmail.com
# SMTP_PASSWORD=tu-password
# SMTP_FROM=noreply@portalpagos.com

# ============================================================================
# COMISIONES Y PARÁMETROS DE NEGOCIO
# ============================================================================

# Porcentaje para la empresa (0.95 = 95%)
COMMISSION_ENTERPRISE=0.95

# Porcentaje para el banco (0.05 = 5%)
COMMISSION_BANK=0.05

# Comisión por transacción en Q
COMMISSION_TRANSACTION_FEE=0.00

# ============================================================================
# LÍMITES Y RESTRICCIONES
# ============================================================================

# Monto máximo por transacción
MAX_TRANSACTION_AMOUNT=10000

# Monto mínimo por transacción
MIN_TRANSACTION_AMOUNT=0.01

# Máximo de intentos de login fallidos
MAX_LOGIN_ATTEMPTS=5

# Tiempo de bloqueo después de intentos fallidos (minutos)
LOGIN_LOCK_TIME=15

# ============================================================================
# LOGGING (Para FASE 2+)
# ============================================================================

# Nivel de log: Debug, Information, Warning, Error, Critical
LOG_LEVEL=Information

# Guardar logs en archivo
# LOG_FILE_ENABLED=true
# LOG_FILE_PATH=logs/app.log
# LOG_FILE_RETENTION_DAYS=30

# ============================================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================================

# Orígenes permitidos (separados por comas)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Métodos HTTP permitidos
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS

# Headers permitidos
CORS_HEADERS=Content-Type,Authorization

# ============================================================================
# CACHE (Para FASE 2+)
# ============================================================================

# Tipo de caché: InMemory o Redis
# CACHE_TYPE=InMemory

# Tiempo de expiración de caché (minutos)
# CACHE_EXPIRATION=30

# Host Redis (si se usa Redis)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ============================================================================
# INTEGRACIONES EXTERNAS (FASE 3+)
# ============================================================================

# APIs de bancos
# BANCO_A_API_URL=https://api.bancoA.com
# BANCO_A_API_KEY=tu-api-key

# Servicios de validación
# VALIDATION_SERVICE_URL=https://validacion.example.com

# ============================================================================
# NOTAS IMPORTANTES
# ============================================================================

# 1. NUNCA subir credenciales reales a GitHub
# 2. Usar .gitignore para archivos .env
# 3. En producción, usar Key Vault o Secrets Manager
# 4. En desarrollo, usar User Secrets:
#    dotnet user-secrets set "API_KEY" "valor"
# 5. Algunas variables ya están en appsettings.json
# 6. Este archivo es solo para referencia y documentación
